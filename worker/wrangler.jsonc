{
  // IMPORTANT: this Worker belongs in a personal Cloudflare account, not a
  // company one. Wrangler otherwise deploys to whichever account your
  // browser/`wrangler login` session happens to hold. Before deploying:
  //   source ./deploy-env.sh && npx wrangler whoami
  // See "Deploying to the right Cloudflare account" in the README.
  "name": "hoppynotes-verify",
  "main": "worker.js",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 }
  },
  "vars": {
    // The site's origin (scheme + host only, no path).
    "ALLOWED_ORIGIN": "https://theruhler.github.io"
  }
  // Secrets are NOT set here. After deploying, run ./set-secrets.sh, or:
  //   wrangler secret put SHARE_TOKEN_SECRET  // required by every request
  //   wrangler secret put ADMIN_CODES         // "label:code,..." for testers
  //   wrangler secret put STRIPE_SECRET_KEY   // only needed to sell
}
